platform :ios, '16.0'
install! 'cocoapods', :deterministic_uuids => true

target 'JaagteRaho' do
  use_frameworks! :linkage => :static
  # Specs are pinned copies of the official CocoaPods specs, avoiding a huge repo checkout.
  pod 'MediaPipeTasksCommon', :podspec => './Podspecs/MediaPipeTasksCommon.podspec.json'
  pod 'MediaPipeTasksVision', :podspec => './Podspecs/MediaPipeTasksVision.podspec.json'
  target 'JaagteRahoTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
